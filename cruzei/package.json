{
  "name": "cruzei",
  "version": "0.1.0",
  "private": true,
  "description": "Cruzei — Quem você quase conheceu hoje. Monorepo do app de encontros baseado em cruzamentos reais.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "backend:dev": "pnpm --filter @cruzei/backend dev",
    "mobile:start": "pnpm --filter @cruzei/mobile start",
    "shared-types:build": "pnpm --filter @cruzei/shared-types build",
    "shared-utils:build": "pnpm --filter @cruzei/shared-utils build"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "turbo": "2.1.3",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@react-native/gradle-plugin": "0.74.87"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/query-core": "5.103.2",
      "path-to-regexp@0.1.12": "0.1.13",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "lodash@<4.18.0": "^4.18.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@tanstack/query-core": "5.103.2"
      }
    }
  }
}
