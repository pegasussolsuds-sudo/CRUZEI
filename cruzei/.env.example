# ===== Cruzei backend env example =====
# Copie pra apps/backend/.env e ajuste os valores.

# OBRIGATÓRIO: development | test | production. Sem ele o backend NÃO sobe (nunca vira development sozinho).
NODE_ENV=development
# Atalhos de dev (código do SMS no log e na resposta do /auth/request-code, recibo "dev" do Premium/Boost).
# true|false; só vale com NODE_ENV=development — com test/production o boot falha. Fora do dev, apague a linha.
DEV_SHORTCUTS=true
# Recibo "dev" aceito em QUALQUER ambiente (beta fechado sem validação da loja): true|false, padrão false.
# Em produção o backend avisa a cada boot: qualquer um ativa Premium/Boost sem pagar.
# ALLOW_DEV_RECEIPTS=false
PORT=3000
API_PREFIX=v1

# Postgres + PostGIS (docker-compose sobe localmente em 5432)
# pool do Prisma: o padrão (núcleos×2+1) esgotou com ~300 usuários simultâneos no teste de carga (25/09).
# connection_limit ≤ max_connections do Postgres ÷ nº de instâncias do backend; pool_timeout em segundos.
DATABASE_URL=postgresql://cruzei:cruzei_dev@localhost:5432/cruzei?schema=public&connection_limit=40&pool_timeout=20
# Produção recusa a senha de exemplo "cruzei_dev" no DATABASE_URL.
# Executor de migrations (pnpm db:migrate): sem MIGRATE_DATABASE_URL usa o DATABASE_URL. Em produção, papel com DDL e
# conexão direta (sem pgbouncer: o advisory lock é de sessão). lock_timeout por arquivo e teto da transação (ms).
# MIGRATE_DATABASE_URL=
# MIGRATE_LOCK_TIMEOUT=15s
# MIGRATE_TX_TIMEOUT_MS=1800000

# Redis
REDIS_URL=redis://localhost:6379

# JWT — este valor de exemplo só serve no dev. Produção exige >= 32 caracteres, diferente deste exemplo e diferente
# de LOCATION_SALT e PHONE_HASH_SECRET. Trocar derruba todas as sessões (o app pede login de novo).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-prod-this-is-a-dev-secret-32chars-min
JWT_ACCESS_TTL=900           # 15 min em segundos
JWT_REFRESH_TTL=2592000      # 30 dias em segundos

# Número reciclado: conta parada há >= AUTH_DORMANT_DAYS pede "Essa conta é sua?" (data de nascimento) no login
# por SMS; AUTH_CLAIM_MAX_ATTEMPTS erros (por conta, somando sem prazo até acertar) ou "não é minha" liberam o
# número. AUTH_DORMANT_DAYS=0 desliga.
# Publicar o app com a tela nova ANTES de ligar no servidor (app antigo mostraria "Código inválido").
AUTH_DORMANT_DAYS=90
AUTH_CLAIM_MAX_ATTEMPTS=3

# ===== SMS do login =====
# Driver: log (dev: não manda SMS; código no log/resposta só com DEV_SHORTCUTS=true) | twilio | zenvia.
# Vazio = log fora de produção. Produção EXIGE twilio ou zenvia (com log ou vazio o backend não sobe).
# Os dois reais vão por HTTPS direto (sem SDK); credencial faltando derruba o boot. Erro nunca loga telefone nem código.
SMS_DRIVER=log
# Twilio: SID + token e o remetente — TWILIO_FROM em E.164 (+1…/+55…) OU um Messaging Service (MG…).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Zenvia (API v2, canal SMS): token da API e o remetente cadastrado no painel da Zenvia.
ZENVIA_API_TOKEN=
ZENVIA_FROM=
# Tetos de envio (pedido recusado não gasta cota). Padrões: 5/h e 10/dia por número, 20/h e 60/dia por IP
# (IPv6 conta por /64). SMS_MAX_PER_HOUR_GLOBAL é o freio de orçamento da hora inteira: 0/vazio = sem teto.
# SMS_MAX_PER_PHONE_HOUR=5
# SMS_MAX_PER_PHONE_DAY=10
# SMS_MAX_PER_IP_HOUR=20
# SMS_MAX_PER_IP_DAY=60
# SMS_MAX_PER_HOUR_GLOBAL=0
# Código errado: SMS_VERIFY_MAX_ATTEMPTS erros (padrão 5) travam o número por SMS_VERIFY_LOCK_S (padrão 900 = 15 min).
# Pedir código novo NÃO devolve as chances.
# SMS_VERIFY_MAX_ATTEMPTS=5
# SMS_VERIFY_LOCK_S=900
# Número de revisão das lojas (Apple/Google): celular BR + código fixo de 6 dígitos (sem sequência nem repetição).
# Nunca manda SMS; vale também em produção. Os dois juntos ou nenhum (só um derruba o boot). Vazio = desligado.
# Use um número que você controla e que não seja de ninguém real; tire depois da revisão.
REVIEW_PHONE=
REVIEW_CODE=

# Firebase (push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=

# ===== Fotos (storage) =====
# Toda foto é reprocessada no servidor (gira pelo EXIF, tira TODO metadado/GPS, JPEG de até 1600 px e 800 KB) e o
# banco guarda só a CHAVE (p/<uuid>.jpg); a URL é montada na saída com STORAGE_PUBLIC_BASE_URL.
# Driver: local (padrão; disco em UPLOAD_DIR, servido em /uploads) | s3 (Cloudflare R2 ou AWS S3, por HTTPS sem SDK).
STORAGE_DRIVER=local
# Base pública das fotos, sem barra no fim. Produção EXIGE (https). Dev vazio = PUBLIC_BASE_URL/uploads ou
# http://127.0.0.1:3000/uploads (celular pelo adb reverse). R2: o domínio público do bucket (ex.: https://fotos.metch.app).
STORAGE_PUBLIC_BASE_URL=
# Endereço do backend visto pelo celular na LAN (dev, sem barra no fim): base das fotos quando a de cima está vazia
# e das fotos do seed-dev. Vazio = http://127.0.0.1:3000.
# PUBLIC_BASE_URL=http://192.168.0.10:3000
# Pasta do driver local (padrão: ./uploads do backend).
# UPLOAD_DIR=
# Só com STORAGE_DRIVER=s3. R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, região auto, path-style.
# A chave de API precisa só de leitura/escrita no bucket das fotos. Faltando qualquer uma, o backend não sobe.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# true (padrão, o R2 exige) = endpoint/bucket/chave; false = bucket.endpoint/chave (virtual-host da AWS)
# STORAGE_S3_FORCE_PATH_STYLE=true
# Cache das fotos no navegador/CDN (a chave nunca muda de conteúdo). Foto apagada pode durar isso em cache.
# STORAGE_CACHE_CONTROL=public, max-age=86400, immutable
# Remoção dos arquivos (fila media_objects, a cada 10 min): on | dry (só loga o que apagaria) | off.
# Foto com rótulo 'urgent' fica 180 dias; conta com denúncia underage/child_safety aberta não perde nenhum arquivo.
STORAGE_GC=on

# "Ir até lá" (GET /geo/search): Photon auto-hospedado, opcional (ver serviço photon no docker-compose.yml).
# Vazio = busca de rua/bairro/cidade só no geo_names do Postgres.
PHOTON_URL=
# Tiles de prédios extras (GET /v1/tiles/bld/{z}/{x}/{y}.mvt): trocar o valor joga fora o cache de tiles no Redis.
# Import novo em extra_buildings já muda a versão sozinho (em até 5 min); isto é só pra forçar.
BLD_TILES_VERSION=1

# Descoberta de lugares pela galera (multidão + "Pôr no Metch"). CROWD_MODE: on | shadow (só registra) | off.
# Conta precisa de CROWD_MIN_ACCOUNT_AGE_D dias (ou selfie verificada) pra contar e contribuir — 0 no dev.
CROWD_MODE=on
CROWD_MIN_ACCOUNT_AGE_D=7
# escala: processos do backend (1 = sem cluster) e prazo de segurança do cache de candidatos (ms)
CLUSTER_WORKERS=1
DISCOVERY_CANDIDATE_TTL_MS=60000

# "Passar" no deck de curtidas: quem eu passei não volta no DECK por tantos dias (o mapa continua mostrando).
# Tabela passes; a limpeza apaga o que passou do prazo.
DISCOVERY_PASS_DAYS=30

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple / Google IAP
APPLE_SHARED_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sentry (diagnóstico de falhas do backend) — opcional. Vazio = desligado (o SDK nem inicializa).
# Vão erros 5xx, exceções não tratadas, falha em cron e no boot; sem corpo, query, headers, cookies nem IP (ver apps/backend/src/instrument.ts).
# O environment dos eventos vem do NODE_ENV. O app tem o próprio DSN em apps/mobile/.env (EXPO_PUBLIC_SENTRY_DSN).
SENTRY_DSN=

# Origens de navegador aceitas no HTTP e no socket (painel web, Expo web), separadas por vírgula, exatas
# (esquema://host[:porta], sem '*', sem path). O app nativo não precisa (não manda Origin ou manda o do próprio servidor).
# Dev vazio = http://localhost:8081,http://localhost:19006. Produção: só https; vazio = nenhuma outra origem (basta se
# o painel estiver na mesma origem da API atrás do proxy). CORS_ORIGINS ainda é lido como nome antigo.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Sal da posição borrada no mapa (/location/nearby, /users/:id). Opcional no dev (avisa no boot e usa um padrão);
# em produção é OBRIGATÓRIO: >= 32 caracteres, aleatório e diferente de JWT_SECRET e PHONE_HASH_SECRET.
# Trocar num ambiente no ar reembaralha o borrado e duplica contagens da multidão até as chaves vencerem.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LOCATION_SALT=

# Segredo do HMAC do telefone (teste grátis do Premium: uma vez por número, em trial_claims — nunca o número cru).
# Obrigatório em produção: >= 32 caracteres, diferente de JWT_SECRET e LOCATION_SALT; em dev cai num padrão com aviso.
# Trocar o valor zera as marcações (o teste grátis volta a valer pra quem já usou).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PHONE_HASH_SECRET=

# --- Privacidade de localização (brief PRIVACIDADE; ver PRIVACIDADE-LOCALIZACAO.md) — todos opcionais ---
# DISCOVERY_RADIUS_M=350            # raio máximo da descoberta individual (o cliente não escolhe)
# DISCOVERY_BAND_VERY_NEAR_M=100    # faixas: bem perto / perto / na região
# DISCOVERY_BAND_NEAR_M=250
# DISCOVERY_CELL_PRECISION=7        # célula da posição visual (geohash-7 ≈ 153 m)
# DISCOVERY_CELL_JITTER_M=35
# DISCOVERY_AREA_PRECISION=6        # área do mínimo de anonimato (geohash-6 ≈ 1,2 km × 0,6 km)
# DISCOVERY_MIN_AREA_K=2            # menos que isso de pessoas visíveis na área → ninguém ganha marcador/identidade
# DISCOVERY_MIN_PLACE_K=2           # mínimo de pessoas num lugar pra nomear quem está lá
# DISCOVERY_PRESENCE_TTL_S=7200
# DISCOVERY_MIN_UPDATE_INTERVAL_S=20
# DISCOVERY_ONLINE_MIN=15
# DISCOVERY_RECENT_MIN=60
# DISCOVERY_HOME_MIN_NIGHTS=3       # madrugadas na mesma célula → área de residência automática
# DISCOVERY_HOME_LEARN_DAYS=45
# PRIVATE_AREA_DEFAULT_RADIUS_M=150 # áreas privadas manuais (50–1000 m, até 5)
# LOCATION_HISTORY_DECIMALS=3       # histórico no Postgres é grosseiro (~110 m) e curto
# LOCATION_HISTORY_RETENTION_DAYS=3
# DISCOVERY_ROTATION_MIN=10         # lugar lotado (> 300): cada pessoa vê um recorte que gira a cada X min (boost na frente)
# GPS falso (anti-spoof.ts): off | shadow (só conta em gps:shadow:<dia>, aceita tudo) | on (padrão: esconde do mapa,
# a pessoa não vê ninguém até normalizar e vai pra fila da moderação por episódios repetidos — nunca bane sozinho).
# Dev com "adb emu geo fix", harness de carga (40 mil) e scripts que pulam de posição: use shadow ou off.
GPS_GUARD=on
# GPS_GUARD_MAX_GROUND_KMH=250      # velocidade máxima entre posições aceitas com menos de 30 min de intervalo
# GPS_GUARD_MAX_AIR_KMH=1000        # a partir de GPS_GUARD_AIR_AFTER_S (1800 s) de intervalo: avião
# GPS_GUARD_NOISE_FLOOR_M=300       # salto menor que isso (descontada a precisão) é ruído, em qualquer intervalo
# GPS_GUARD_SHORT_DT_S=60           # com intervalo menor que isso, salto acima do ruído precisa de velocidade plausível
# GPS_GUARD_MIN_JUMP_M=1500         # com intervalo >= SHORT_DT_S, salto menor que isso (descontada a precisão) é ruído
# GPS_GUARD_WINDOW_S=300            # velocidade acumulada: compara também com a posição aceita de até X s atrás
# GPS_GUARD_ACC_TOLERANCE_CAP_M=200 # quanto a precisão informada pode descontar da distância, no máximo
# GPS_GUARD_ACC_IGNORE_M=500        # precisão pior que isso (antena, aproximada): nunca segura nem conta strike; a 1ª vira presença, depois só anda se plausível
# GPS_GUARD_CONFIRM_S=45            # posição nova depois de um salto vira verdade se repetir por X s (viagem de verdade)
# GPS_GUARD_STRIKES_TELEPORT=5      # episódios em 24 h que mandam pra fila da moderação (salto / posição simulada)
# GPS_GUARD_STRIKES_MOCK=3
# GPS_GUARD_FLAG_TTL_S=900          # escondida por GPS falso: no máximo X s sem uma posição boa
# PHOTO_ALLOWED_HOSTS=              # hosts extras aceitos na mídia do chat, separados por vírgula (o de STORAGE_PUBLIC_BASE_URL já entra; foto de perfil vai pela chave do upload)

# --- Moderação e documentos legais ---
# Fotos novas: off (vai ao ar na hora — só dev) | manual (fica "em análise" até um moderador aprovar no app) |
# rekognition (análise automática da AWS: aprova o claro, recusa o explícito, o resto vai pra fila humana).
# Produção não sobe com "off". Com rekognition, credenciais da AWS pelo padrão do SDK (AWS_ACCESS_KEY_ID/…).
PHOTO_MODERATION=off
AWS_REGION=us-east-1
# Mídia no chat (foto/áudio) fica desligada até passar pela moderação de fotos
CHAT_MEDIA_ENABLED=false
# Dados dos Termos/Política/Padrões de segurança infantil (cruzei/legal/*.md). Produção não sobe sem eles.
# Páginas públicas: GET /legal/termos, /legal/privacidade, /legal/seguranca-infantil (URL da política nas lojas) e
# /legal/excluir-conta (URL de exclusão da conta pedida pelo Google Play).
LEGAL_COMPANY_NAME=
LEGAL_CNPJ=
LEGAL_ADDRESS=
LEGAL_FORUM=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
DPO_NAME=
CHILD_SAFETY_EMAIL=
# pasta dos .md (padrão: cruzei/legal, achada a partir do processo)
# LEGAL_DIR=
# Papel de moderação: UPDATE users SET role = 'moderator' (ou 'admin') WHERE phone = '+55…';  → aba Perfil > Moderação

# --- Conta e privacidade (excluir conta, baixar meus dados, apagar histórico de localização) ---
# Valor inválido cai no padrão. A limpeza definitiva roda no processo dos crons (a cada 10 min; retenção às 3h40).
# ACCOUNT_DELETION_GRACE_DAYS=30         # prazo pra voltar atrás (0 = limpa na próxima rodada; só dev/teste)
# ACCOUNT_EVIDENCE_RETENTION_DAYS=180    # conversas citadas em denúncia, contados do fim da denúncia
# PAYMENT_RECORDS_RETENTION_YEARS=5      # assinaturas e Boosts de conta limpa (fiscal/CDC)
# DATA_EXPORT_DAILY_LIMIT=3              # cópias dos dados por pessoa por dia
# LOCATION_FORGET_DAILY_LIMIT=3          # "apagar histórico de localização" por dia (zera as âncoras do anti-GPS-falso)

# Produção atrás de balanceador/proxy (TLS): número EXATO de proxies na frente da API (ex.: 1). Sem isso o limite
# de login e do SMS vira um balde só pra todo mundo e os registros de acesso (Marco Civil) gravam o IP do proxy.
# 0/vazio = sem proxy (dev; em produção avisa
# no boot). O proxy precisa preservar o Host (nginx: proxy_set_header Host $host) ou mandar X-Forwarded-Host: o socket
# do app nativo em produção só entra com Origin igual ao host da API.
TRUST_PROXY_HOPS=0
