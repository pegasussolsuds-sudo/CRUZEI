# ===== Cruzei backend env example =====
# Copie pra apps/backend/.env e ajuste os valores.

NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Postgres + PostGIS (docker-compose sobe localmente em 5432)
# pool do Prisma: o padrão (núcleos×2+1) esgotou com ~300 usuários simultâneos no teste de carga (25/09).
# connection_limit ≤ max_connections do Postgres ÷ nº de instâncias do backend; pool_timeout em segundos.
DATABASE_URL=postgresql://cruzei:cruzei_dev@localhost:5432/cruzei?schema=public&connection_limit=40&pool_timeout=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-prod-this-is-a-dev-secret-32chars-min
JWT_ACCESS_TTL=900           # 15 min em segundos
JWT_REFRESH_TTL=2592000      # 30 dias em segundos

# Firebase (SMS code + push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=

# Cloudflare R2 (fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cruzei-photos
R2_PUBLIC_URL=https://cdn.cruzei.com.br

# "Ir até lá" (GET /geo/search): Photon auto-hospedado, opcional (ver serviço photon no docker-compose.yml).
# Vazio = busca de rua/bairro/cidade só no geo_names do Postgres.
PHOTON_URL=
# Tiles de prédios extras (GET /v1/tiles/bld/{z}/{x}/{y}.mvt): trocar o valor joga fora o cache de tiles no Redis.
# Import novo em extra_buildings já muda a versão sozinho (em até 5 min); isto é só pra forçar.
BLD_TILES_VERSION=1

# Descoberta de lugares pela galera (multidão + "Pôr no Metch"). CROWD_MODE: on | shadow (só registra) | off.
# Conta precisa de CROWD_MIN_ACCOUNT_AGE_D dias (ou selfie verificada) pra contar e contribuir — 0 no dev.
CROWD_MODE=on
CROWD_MIN_ACCOUNT_AGE_D=7
# escala: processos do backend (1 = sem cluster) e prazo de segurança do cache de candidatos (ms)
CLUSTER_WORKERS=1
DISCOVERY_CANDIDATE_TTL_MS=60000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple / Google IAP
APPLE_SHARED_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sentry (diagnóstico de falhas do backend) — opcional. Vazio = desligado (o SDK nem inicializa).
# Vão erros 5xx, exceções não tratadas, falha em cron e no boot; sem corpo, query, headers, cookies nem IP (ver apps/backend/src/instrument.ts).
# O environment dos eventos vem do NODE_ENV. O app tem o próprio DSN em apps/mobile/.env (EXPO_PUBLIC_SENTRY_DSN).
SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Sal da posição borrada no mapa (/location/nearby, /users/:id). Opcional (o backend avisa no boot se faltar);
# em produção use um valor aleatório e longo — ex.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOCATION_SALT=

# --- Privacidade de localização (brief PRIVACIDADE; ver PRIVACIDADE-LOCALIZACAO.md) — todos opcionais ---
# DISCOVERY_RADIUS_M=350            # raio máximo da descoberta individual (o cliente não escolhe)
# DISCOVERY_BAND_VERY_NEAR_M=100    # faixas: bem perto / perto / na região
# DISCOVERY_BAND_NEAR_M=250
# DISCOVERY_CELL_PRECISION=7        # célula da posição visual (geohash-7 ≈ 153 m)
# DISCOVERY_CELL_JITTER_M=35
# DISCOVERY_AREA_PRECISION=6        # área do mínimo de anonimato (geohash-6 ≈ 1,2 km × 0,6 km)
# DISCOVERY_MIN_AREA_K=2            # menos que isso de pessoas visíveis na área → ninguém ganha marcador/identidade
# DISCOVERY_MIN_PLACE_K=2           # mínimo de pessoas num lugar pra nomear quem está lá
# DISCOVERY_PRESENCE_TTL_S=7200
# DISCOVERY_MIN_UPDATE_INTERVAL_S=20
# DISCOVERY_ONLINE_MIN=15
# DISCOVERY_RECENT_MIN=60
# DISCOVERY_HOME_MIN_NIGHTS=3       # madrugadas na mesma célula → área de residência automática
# DISCOVERY_HOME_LEARN_DAYS=45
# PRIVATE_AREA_DEFAULT_RADIUS_M=150 # áreas privadas manuais (50–1000 m, até 5)
# LOCATION_HISTORY_DECIMALS=3       # histórico no Postgres é grosseiro (~110 m) e curto
# LOCATION_HISTORY_RETENTION_DAYS=3
# PHOTO_ALLOWED_HOSTS=              # hosts extras (R2/CDN) aceitos em POST /me/photos, separados por vírgula

# --- Moderação e documentos legais ---
# Fotos novas: off (vai ao ar na hora — só dev) | manual (fica "em análise" até um moderador aprovar no app) |
# rekognition (análise automática da AWS: aprova o claro, recusa o explícito, o resto vai pra fila humana).
# Produção não sobe com "off". Com rekognition, credenciais da AWS pelo padrão do SDK (AWS_ACCESS_KEY_ID/…).
PHOTO_MODERATION=off
AWS_REGION=us-east-1
# Mídia no chat (foto/áudio) fica desligada até passar pela moderação de fotos
CHAT_MEDIA_ENABLED=false
# Dados dos Termos/Política/Padrões de segurança infantil (cruzei/legal/*.md). Produção não sobe sem eles.
# Páginas públicas: GET /legal/termos, /legal/privacidade, /legal/seguranca-infantil (URL da política nas lojas).
LEGAL_COMPANY_NAME=
LEGAL_CNPJ=
LEGAL_ADDRESS=
LEGAL_FORUM=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
DPO_NAME=
CHILD_SAFETY_EMAIL=
# pasta dos .md (padrão: cruzei/legal, achada a partir do processo)
# LEGAL_DIR=
# Papel de moderação: UPDATE users SET role = 'moderator' (ou 'admin') WHERE phone = '+55…';  → aba Perfil > Moderação
