# ===== Cruzei backend env example =====
# Copie pra apps/backend/.env e ajuste os valores.

NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Postgres + PostGIS (docker-compose sobe localmente em 5432)
DATABASE_URL=postgresql://cruzei:cruzei_dev@localhost:5432/cruzei?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-prod-this-is-a-dev-secret-32chars-min
JWT_ACCESS_TTL=900           # 15 min em segundos
JWT_REFRESH_TTL=2592000      # 30 dias em segundos

# Firebase (SMS code + push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=

# Cloudflare R2 (fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cruzei-photos
R2_PUBLIC_URL=https://cdn.cruzei.com.br

# Mapbox
MAPBOX_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple / Google IAP
APPLE_SHARED_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sentry
SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Sal da posição borrada no mapa (/location/nearby, /users/:id). Opcional (o backend avisa no boot se faltar);
# em produção use um valor aleatório e longo — ex.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOCATION_SALT=

# --- Privacidade de localização (brief PRIVACIDADE; ver PRIVACIDADE-LOCALIZACAO.md) — todos opcionais ---
# DISCOVERY_RADIUS_M=350            # raio máximo da descoberta individual (o cliente não escolhe)
# DISCOVERY_BAND_VERY_NEAR_M=100    # faixas: bem perto / perto / na região
# DISCOVERY_BAND_NEAR_M=250
# DISCOVERY_CELL_PRECISION=7        # célula da posição visual (geohash-7 ≈ 153 m)
# DISCOVERY_CELL_JITTER_M=35
# DISCOVERY_AREA_PRECISION=6        # área do mínimo de anonimato (geohash-6 ≈ 1,2 km × 0,6 km)
# DISCOVERY_MIN_AREA_K=2            # menos que isso de pessoas visíveis na área → ninguém ganha marcador/identidade
# DISCOVERY_MIN_PLACE_K=2           # mínimo de pessoas num lugar pra nomear quem está lá
# DISCOVERY_PRESENCE_TTL_S=7200
# DISCOVERY_MIN_UPDATE_INTERVAL_S=20
# DISCOVERY_ONLINE_MIN=15
# DISCOVERY_RECENT_MIN=60
# DISCOVERY_HOME_MIN_NIGHTS=3       # madrugadas na mesma célula → área de residência automática
# DISCOVERY_HOME_LEARN_DAYS=45
# PRIVATE_AREA_DEFAULT_RADIUS_M=150 # áreas privadas manuais (50–1000 m, até 5)
# LOCATION_HISTORY_DECIMALS=3       # histórico no Postgres é grosseiro (~110 m) e curto
# LOCATION_HISTORY_RETENTION_DAYS=3
# PHOTO_ALLOWED_HOSTS=              # hosts extras (R2/CDN) aceitos em POST /me/photos, separados por vírgula
