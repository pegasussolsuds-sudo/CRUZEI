# ===== Mobile env example =====
# Copie pra apps/mobile/.env. Só variáveis EXPO_PUBLIC_* chegam no bundle.

# API — use o IP do host na LAN pra testar em device físico (localhost só funciona com adb reverse)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.8:3000/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.8:3000
EXPO_PUBLIC_ENV=development

# Sentry (diagnóstico de falhas) — OPCIONAL. Vazio = Sentry desligado (o SDK nem inicializa).
# O DSN não é segredo (só permite enviar eventos), por isso pode ir no bundle.
# EXPO_PUBLIC_ENV acima vira o "environment" dos eventos — use production no build das lojas.
EXPO_PUBLIC_SENTRY_DSN=
# Override de release/dist — normalmente deixe vazio: o SDK nativo usa app.metch@versão+build,
# o mesmo nome que o upload dos source maps usa. Só preencha se o CI também mandar esse nome no upload.
# EXPO_PUBLIC_SENTRY_RELEASE=
# EXPO_PUBLIC_SENTRY_DIST=
#
# Upload de source maps/símbolos no build do Gradle: estas são variáveis do SHELL/CI, lidas pelo sentry.gradle.
# NUNCA com prefixo EXPO_PUBLIC_ (iriam pro bundle) e NUNCA neste arquivo nem no repositório:
#   SENTRY_AUTH_TOKEN=...            token da organização (segredo)
#   SENTRY_ORG=...                   slug da organização
#   SENTRY_PROJECT=...               slug do projeto
#   SENTRY_DISABLE_AUTO_UPLOAD=true  pula o upload — use em build local/sem token (sem ela, o upload
#                                    do release chama o sentry-cli e precisa das três de cima)

# Futuro
# EXPO_PUBLIC_ANALYTICS_KEY=
