generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  phone                 String?               @unique @db.VarChar(20)
  email                 String?               @unique @db.VarChar(255)
  passwordHash          String?               @map("password_hash") @db.VarChar(255)
  name                  String                @db.VarChar(50)
  birthDate             DateTime              @map("birth_date") @db.Date
  gender                Gender
  /// opcional; exibir e "mesma orientação primeiro" exigem orientação (CHECK users_orientation_flags_chk na migration)
  orientation           Orientation?
  /// consentimento específico (LGPD): carimbado quando a pessoa escolhe a orientação no app
  orientationConsentedAt DateTime?            @map("orientation_consented_at") @db.Timestamp(6)
  /// exibir a orientação no cartão público (padrão: não)
  showOrientation       Boolean               @default(false) @map("show_orientation")
  /// ver primeiro quem tem a MESMA orientação (só conta quem exibe a sua); só ordenação, não filtro
  sameOrientationFirst  Boolean               @default(false) @map("same_orientation_first")
  /// quem eu quero ver no mapa, na lista e no deck (recíproco)
  showMe                ShowMe                @default(everyone) @map("show_me")
  /// filtro de idade do "quem ver" (só o que EU vejo, não recíproco); 18–99 = sem limite; vão mínimo de 4 anos (CHECK users_age_range_chk)
  ageMin                Int                   @default(18) @map("age_min") @db.SmallInt
  ageMax                Int                   @default(99) @map("age_max") @db.SmallInt
  /// @ do Instagram sem o @, minúsculo, público (CHECK users_instagram_handle_chk na migration)
  instagramHandle       String?               @map("instagram_handle") @db.VarChar(30)
  lookingFor            LookingFor            @default(unspecified) @map("looking_for")
  bio                   String?
  avatarConfig          Json?                 @map("avatar_config")
  premiumTier           PremiumTier           @default(free) @map("premium_tier")
  premiumExpiresAt      DateTime?             @map("premium_expires_at")
  visibilityMode        VisibilityMode        @default(visible) @map("visibility_mode")
  /// fim da janela do invisível grátis (24 h; atual ou a última); null = sem janela (visível ou Premium vigente). UTC
  anonymousUntil        DateTime?             @map("anonymous_until") @db.Timestamp(6)
  /// quando usou o teste grátis (uma vez por conta; por telefone em trial_claims)
  trialUsedAt           DateTime?             @map("trial_used_at") @db.Timestamp(6)
  isPaused              Boolean               @default(false) @map("is_paused")
  pausedUntil           DateTime?             @map("paused_until") @db.Timestamp(6)
  showDistance          Boolean               @default(true) @map("show_distance")
  showAge               Boolean               @default(true) @map("show_age")
  showPhotoOnMap        Boolean               @default(true) @map("show_photo_on_map")
  discoveryMode         DiscoveryMode         @default(everyone) @map("discovery_mode")
  privateAreas          PrivateArea[]
  isVerified            Boolean               @default(false) @map("is_verified")
  verifiedAt            DateTime?             @map("verified_at") @db.Timestamp(6)
  verificationSelfieUrl String?               @map("verification_selfie_url") @db.VarChar(500)
  profileCompleteness   Int                   @default(0) @map("profile_completeness") @db.SmallInt
  dataRetentionUntil    DateTime?             @map("data_retention_until") @db.Date
  /// exclusão pedida (some na hora; ACCOUNT_DELETION_GRACE_DAYS pra voltar); pedido em data_deletion_requests
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamp(6)
  /// limpeza definitiva feita: linha "conta limpa" sem dado pessoal, só pras FKs (CHECK users_purged_clean_chk na migration)
  purgedAt              DateTime?             @map("purged_at") @db.Timestamp(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)
  lastActiveAt          DateTime              @default(now()) @map("last_active_at") @db.Timestamp(6)
  role                  UserRole              @default(user)
  accountStatus         AccountStatus         @default(active) @map("account_status")
  suspendedUntil        DateTime?             @map("suspended_until") @db.Timestamp(6)
  moderationReason      String?               @map("moderation_reason") @db.VarChar(255)
  reviewHoldAt          DateTime?             @map("review_hold_at") @db.Timestamp(6)
  termsVersion          String?               @map("terms_version") @db.VarChar(20)
  termsAcceptedAt       DateTime?             @map("terms_accepted_at") @db.Timestamp(6)
  /// quando o número saiu desta conta (número reciclado; histórico em phone_releases)
  phoneReleasedAt       DateTime?             @map("phone_released_at") @db.Timestamp(6)
  /// token com iat anterior a isto é recusado (401 session_revoked) no refresh, no Bearer e no socket
  sessionsValidAfter    DateTime?             @map("sessions_valid_after") @db.Timestamp(6)
  moderationActionsMade ModerationAction[]    @relation("Moderator")
  auditLogs             AuditLog[]
  blocksReceived        Block[]               @relation("Blocked")
  blocksMade            Block[]               @relation("Blocker")
  boosts                Boost[]
  conversationsAsLow    Conversation[]        @relation("ConversationUserLow")
  conversationsAsHigh   Conversation[]        @relation("ConversationUserHigh")
  conversationMembers   ConversationMember[]
  dataDeletionRequests  DataDeletionRequest[]
  deviceTokens          DeviceToken[]
  likesReceived         Like[]                @relation("Liked")
  likesSent             Like[]                @relation("Liker")
  locations             Location[]
  matchesAsA            Match[]               @relation("UserA")
  matchesAsB            Match[]               @relation("UserB")
  messagesSent          Message[]             @relation("MessageSender")
  notifications         Notification[]
  photos                Photo[]
  poisCheckins          PoisCheckin[]
  reportsReceived       Report[]              @relation("Reported")
  reportsMade           Report[]              @relation("Reporter")
  reportsReviewed       Report[]              @relation("Reviewer")
  seals                 Seal[]
  subscriptions         Subscription[]
  userInterests         UserInterest[]
  visitsReceived        Visit[]               @relation("Visited")
  visitsSent            Visit[]               @relation("Visitor")

  @@index([phone], map: "idx_users_phone")
  @@index([email], map: "idx_users_email")
  @@index([premiumTier], map: "idx_users_premium")
  @@index([lastActiveAt(sort: Desc)], map: "idx_users_active")
  @@map("users")
}

/// Área privada definida pelo próprio usuário (casa, trabalho…): dentro dela ele não é descoberto por ninguém.
/// Coordenada precisa do PRÓPRIO usuário — só ele lê/escreve; nunca sai pra terceiros.
model PrivateArea {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(40)
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  radiusM   Int      @map("radius_m") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("private_areas")
}

/// url e thumbnailUrl guardam a CHAVE do objeto no storage (p/<uuid>.jpg) ou uma URL absoluta legada/externa; a URL
/// pública sai de photoUrl(). O gatilho photos_release_media (AFTER DELETE → fila media_objects) e o índice único
/// parcial photos_url_key_uq existem só na migration 20261005000100_media_objects.
model Photo {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  url            String      @db.VarChar(500)
  thumbnailUrl   String?     @map("thumbnail_url") @db.VarChar(500)
  orderIndex     Int         @default(0) @map("order_index") @db.SmallInt
  isMain         Boolean     @default(false) @map("is_main")
  source         PhotoSource @default(user_upload)
  isFaceVerified Boolean     @default(false) @map("is_face_verified")
  status         PhotoStatus @default(approved)
  moderationLabels Json?     @map("moderation_labels")
  reviewedAt     DateTime?   @map("reviewed_at") @db.Timestamp(6)
  reviewedBy     String?     @map("reviewed_by") @db.Uuid
  rejectReason   String?     @map("reject_reason") @db.VarChar(100)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orderIndex])
  @@index([userId, orderIndex])
  @@index([url], map: "photos_url_idx")
  @@index([thumbnailUrl], map: "photos_thumbnail_url_idx")
  @@map("photos")
}

/// objeto no storage (driver local ou s3) e fila de remoção do arquivo (migration 20261005000100_media_objects).
/// Upload novo: ownerId = quem subiu, deleteAfter = +24 h até ser anexado. Foto apagada: o gatilho photos_release_media
/// enfileira (deleteAfter = agora; rótulo 'urgent' = +180 dias). O MediaGcService apaga com lease e checagem de referência.
/// ownerId sem FK: sobrevive à limpeza da conta. CHECK media_objects_kind_chk ('photo') só na migration.
model MediaObject {
  key            String    @id @db.VarChar(200)
  ownerId        String?   @map("owner_id") @db.Uuid
  kind           String    @default("photo") @db.VarChar(16)
  thumbKey       String?   @map("thumb_key") @db.VarChar(200)
  bytes          Int?
  width          Int?      @db.SmallInt
  height         Int?      @db.SmallInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// anexado a uma foto; null = upload solto
  attachedAt     DateTime? @map("attached_at") @db.Timestamptz(6)
  /// quando pode apagar do storage; null = em uso (índice parcial media_objects_delete_idx)
  deleteAfter    DateTime? @map("delete_after") @db.Timestamptz(6)
  deleteAttempts Int       @default(0) @map("delete_attempts") @db.SmallInt
  lastError      String?   @map("last_error") @db.VarChar(200)

  @@index([ownerId], map: "media_objects_owner_idx")
  @@map("media_objects")
}

model Interest {
  id       Int            @id @default(autoincrement()) @db.SmallInt
  name     String         @unique @db.VarChar(50)
  icon     String?        @db.VarChar(50)
  category String?        @db.VarChar(50)
  users    UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId Int      @map("interest_id") @db.SmallInt
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([userId])
  @@map("user_interests")
}

model Location {
  id             BigInt   @id @default(autoincrement())
  userId         String   @map("user_id") @db.Uuid
  latitude       Decimal  @db.Decimal(10, 8)
  longitude      Decimal  @db.Decimal(11, 8)
  geohash        String   @db.VarChar(12)
  accuracyMeters Int?     @map("accuracy_meters") @db.SmallInt
  poiId          BigInt?  @map("poi_id")
  city           String?  @db.VarChar(100)
  state          String?  @db.Char(2)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamp(6)
  expiresAt      DateTime @default(now()) @map("expires_at") @db.Timestamp(6)
  isAnonymous    Boolean  @default(false) @map("is_anonymous")
  poi            POI?     @relation("PoiLocations", fields: [poiId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc)])
  @@index([poiId, recordedAt(sort: Desc)])
  @@index([poiId, expiresAt])
  @@index([geohash])
  @@index([expiresAt])
  @@index([city])
  @@map("locations")
}

model POI {
  id             BigInt        @id @default(autoincrement())
  externalId     String?       @map("external_id") @db.VarChar(100)
  name           String        @db.VarChar(255)
  category       POICategory
  subcategory    String?       @db.VarChar(50)
  latitude       Decimal       @db.Decimal(10, 8)
  longitude      Decimal       @db.Decimal(11, 8)
  address        String?       @db.VarChar(500)
  city           String?       @db.VarChar(100)
  state          String?       @db.Char(2)
  neighborhood   String?       @db.VarChar(100)
  rating         Decimal?      @db.Decimal(2, 1)
  totalRatings   Int           @default(0) @map("total_ratings")
  phone          String?       @db.VarChar(30)
  website        String?       @db.VarChar(500)
  hours          Json?
  photos         Json?
  isPartner      Boolean       @default(false) @map("is_partner")
  partnerOffer   String?       @map("partner_offer")
  source         String        @default("osm") @db.VarChar(20)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  lastVerifiedAt DateTime?     @map("last_verified_at") @db.Timestamp(6)
  /// oculto pela equipe: some de toda leitura do app (mapa, vibe, detalhe, check-in, presença); o painel ainda vê
  hiddenAt       DateTime?     @map("hidden_at") @db.Timestamptz(6)
  /// POI de mapa de um evento (source 'admin'); índice único parcial pois_event_id_uq na migration
  eventId        String?       @map("event_id") @db.Uuid
  locations      Location[]    @relation("PoiLocations")
  matches        Match[]       @relation("PoiMatches")
  checkins       PoisCheckin[]

  @@unique([source, externalId])
  @@index([category])
  @@index([city, category])
  @@index([isPartner])
  @@map("pois")
}

model PoisCheckin {
  id              BigInt   @id @default(autoincrement())
  userId          String   @map("user_id") @db.Uuid
  poiId           BigInt   @map("poi_id")
  checkinAt       DateTime @default(now()) @map("checkin_at") @db.Timestamp(6)
  durationMinutes Int?     @map("duration_minutes")
  poi             POI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkinAt(sort: Desc)])
  @@index([poiId, checkinAt(sort: Desc)])
  @@map("pois_checkins")
}

model Like {
  id         BigInt   @id @default(autoincrement())
  likerId    String   @map("liker_id") @db.Uuid
  likedId    String   @map("liked_id") @db.Uuid
  isSuper    Boolean  @default(false) @map("is_super")
  locationId BigInt?  @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  liked      User     @relation("Liked", fields: [likedId], references: [id], onDelete: Cascade)
  liker      User     @relation("Liker", fields: [likerId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
  @@index([likerId, createdAt(sort: Desc)])
  @@index([likedId, createdAt(sort: Desc)])
  @@map("likes")
}

/// CONGELADO desde a inbox (migration 20261001000000_inbox): ninguém lê nem grava. Cada match virou a Conversation
/// do par com o mesmo id; a tabela e o enum MatchStatus saem numa migration posterior.
model Match {
  id            String      @id @default(uuid()) @db.Uuid
  userAId       String      @map("user_a_id") @db.Uuid
  userBId       String      @map("user_b_id") @db.Uuid
  locationId    BigInt?     @map("location_id")
  poiId         BigInt?     @map("poi_id")
  contextText   String?     @map("context_text") @db.VarChar(255)
  status        MatchStatus @default(active)
  chatExpiresAt DateTime    @default(now()) @map("chat_expires_at") @db.Timestamp(6)
  lastRenewedAt DateTime    @default(now()) @map("last_renewed_at") @db.Timestamp(6)
  matchedAt     DateTime    @default(now()) @map("matched_at") @db.Timestamp(6)
  poi           POI?        @relation("PoiMatches", fields: [poiId], references: [id])
  userA         User        @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User        @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, matchedAt(sort: Desc)])
  @@index([userBId, matchedAt(sort: Desc)])
  @@index([status])
  @@index([chatExpiresAt])
  @@map("matches")
}

/// Conversa do par (uma por par: userLowId < userHighId, CHECK conv_pair_order na migration). O chat nunca é bloqueado:
/// a pasta só muda ONDE aparece. Pasta GRAVADA: promotedAt != null = principal (curtida mútua, resposta dos dois lados
/// ou "mover pra principal"); é permanente. Regras em src/modules/inbox/routing.ts.
model Conversation {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId      String               @map("user_low_id") @db.Uuid
  userHighId     String               @map("user_high_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  lastMessageAt  DateTime?            @map("last_message_at") @db.Timestamp(6)
  promotedAt     DateTime?            @map("promoted_at") @db.Timestamp(6)
  /// 'mutual' | 'bounce' | 'manual' (CHECK conv_promoted_reason_chk na migration)
  promotedReason String?              @map("promoted_reason") @db.VarChar(16)
  userLow        User                 @relation("ConversationUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh       User                 @relation("ConversationUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  members        ConversationMember[]
  messages       Message[]

  @@unique([userLowId, userHighId], map: "conv_pair_uq")
  @@index([userHighId], map: "idx_conversations_user_high")
  @@index([lastMessageAt(sort: Desc)], map: "idx_conv_last_msg")
  @@map("conversations")
}

/// A linha de cada pessoa na conversa. unreadCount é contador transacional (CHECK >= 0; o app nunca calcula).
/// archivedAt != null = fora do inbox dessa pessoa (bloqueio, banimento, "arquivar conversa").
/// Índice parcial idx_conv_members_user (user_id) WHERE archived_at IS NULL: só na migration (o Prisma 5 não modela).
model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           MemberRole
  unreadCount    Int          @default(0) @map("unread_count")
  isMuted        Boolean      @default(false) @map("is_muted")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  /// congelado: só as mensagens de antes da inbox têm (sem FK); sai junto com a tabela matches
  matchId        String?      @map("match_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String?      @map("content")
  messageType    MessageType  @default(text) @map("message_type")
  /// mensagem de sistema (ex.: 'mutual_like'); no máximo uma de cada tipo por conversa; null nas normais
  systemKind     String?      @map("system_kind") @db.VarChar(32)
  mediaUrl       String?      @map("media_url") @db.VarChar(500)
  mediaExpiresAt DateTime?    @map("media_expires_at") @db.Timestamp(6)
  lat            Decimal?     @db.Decimal(10, 8)
  lng            Decimal?     @db.Decimal(11, 8)
  readAt         DateTime?    @map("read_at") @db.Timestamp(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt      DateTime?    @map("expires_at") @db.Timestamp(6)
  /// id que o app gerou pra mensagem (reenvio idempotente); só quem enviou vê de volta; null em sistema/antigas
  clientId       String?      @map("client_id") @db.VarChar(64)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // NULLs são distintos no Postgres: as mensagens normais (systemKind nulo) não colidem
  @@unique([conversationId, systemKind], map: "uq_messages_conv_system_kind")
  // uma chave de reenvio por remetente, nas duas rotas de envio (sem clientId = NULL, não colide)
  @@unique([senderId, clientId], map: "uq_messages_sender_client_id")
  @@index([conversationId, createdAt(sort: Desc)], map: "idx_messages_conv_created")
  @@index([matchId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model Visit {
  id           BigInt   @id @default(autoincrement())
  visitorId    String   @map("visitor_id") @db.Uuid
  visitedId    String   @map("visited_id") @db.Uuid
  wasAnonymous Boolean  @default(false) @map("was_anonymous")
  visitedAt    DateTime @default(now()) @map("visited_at") @db.Timestamp(6)
  visited      User     @relation("Visited", fields: [visitedId], references: [id], onDelete: Cascade)
  visitor      User     @relation("Visitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, visitedId, visitedAt])
  @@index([visitorId, visitedAt(sort: Desc)])
  @@index([visitedId, visitedAt(sort: Desc)])
  @@map("visits")
}

model Seal {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id") @db.Uuid
  sealType    SealType  @map("seal_type")
  progress    Int       @default(1)
  target      Int       @default(5)
  isCompleted Boolean   @default(false) @map("is_completed")
  earnedAt    DateTime? @map("earned_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sealType])
  @@index([userId])
  @@map("seals")
}

model Block {
  id        BigInt   @id @default(autoincrement())
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String?      @map("reporter_id") @db.Uuid
  reportedId   String       @map("reported_id") @db.Uuid
  /// REPORT_REASONS (escolhidos no app) ou SYSTEM_REPORT_REASONS ('emergency'); automática do filtro de abuso: 'scam'
  /// com reporterId null e context.source 'auto_filter' (única pendente por pessoa+motivo: reports_auto_filter_pending_uq)
  reason       String       @db.VarChar(50)
  description  String?
  evidenceUrls Json?        @map("evidence_urls")
  status       ReportStatus @default(pending)
  reviewedBy   String?      @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamp(6)
  actionTaken  String?      @map("action_taken") @db.VarChar(255)
  priority     Int          @default(0) @db.SmallInt
  context      Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  reported     User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter     User?        @relation("Reporter", fields: [reporterId], references: [id])
  reviewer     User?        @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([reportedId])
  @@map("reports")
}

model Subscription {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @map("user_id") @db.Uuid
