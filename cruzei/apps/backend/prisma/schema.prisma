/// pedido de exclusão da conta (migration 20261005000000_account_privacy). Um pendente por pessoa (índice único parcial
/// ddr_one_pending_uq); fila da limpeza em ddr_due_idx. CHECKs ddr_*_chk só na migration.
model DataDeletionRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamp(6)
  /// fim do prazo de arrependimento: a limpeza definitiva roda a partir daqui
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamp(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamp(6)
  /// 'pending' | 'cancelled' | 'completed' (completed exige completedAt; cancelled exige cancelledAt)
  status       String    @default("pending") @db.VarChar(20)
  /// 'app' | 'support' | 'admin'
  source       String    @default("app") @db.VarChar(10)
  /// DELETION_REASONS (shared-types) ou null
  reason       String?   @db.VarChar(20)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamp(6)
  /// limpeza adiada: 'open_reports' (denúncia em análise) | 'review_hold' (conta em revisão); null = sem bloqueio
  holdReason   String?   @map("hold_reason") @db.VarChar(20)
  /// tentativas da limpeza e último erro (idempotente: a próxima rodada termina)
  attempts     Int       @default(0) @db.SmallInt
  lastError    String?   @map("last_error") @db.VarChar(255)
  /// HMAC(PHONE_HASH_SECRET) do número, gravado na limpeza (nunca o número)
  phoneHash    String?   @map("phone_hash") @db.VarChar(64)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)], map: "ddr_user_idx")
  @@map("data_deletion_requests")
}

model AuditLog {
