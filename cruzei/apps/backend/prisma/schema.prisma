// ---------- número reciclado e teste grátis (migrations 20261003000000_phone_recycling e 20261003010000_premium_rules) ----------

/// histórico de liberação de número (conta parada que perdeu o telefone). Sem FK: sobrevive à exclusão da conta.
/// reason: 'not_mine' | 'birthdate_mismatch' | 'account_deleted' | 'admin' (CHECK phone_releases_reason_chk na migration)
model PhoneRelease {
  id            BigInt        @id @default(autoincrement())
  /// conta antiga, que perdeu o número
  userId        String        @map("user_id") @db.Uuid
  /// número inteiro (só admin vê inteiro); null depois da limpeza de conta não banida (fica o phoneHash)
  phone         String?       @db.VarChar(20)
  /// HMAC do número que saiu na limpeza (6 meses, como data_deletion_requests.phone_hash)
  phoneHash     String?       @map("phone_hash") @db.VarChar(64)
  reason        String        @db.VarChar(20)
  /// situação da conta antiga na hora (banida/suspensa → conta nova nasce em revisão)
  accountStatus AccountStatus @map("account_status")
  lastUsedAt    DateTime?     @map("last_used_at") @db.Timestamptz(6)
  ip            String?       @db.VarChar(45)
  port          Int?
  userAgent     String?       @map("user_agent") @db.VarChar(255)
  /// admin que liberou pelo painel (reason 'admin')
  releasedBy    String?       @map("released_by") @db.Uuid
  /// conta criada depois com este número
  newUserId     String?       @map("new_user_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "phone_releases_user_idx")
  @@index([phone, createdAt(sort: Desc)], map: "phone_releases_phone_idx")
  @@map("phone_releases")
}

/// teste grátis por telefone: HMAC-SHA256 do número normalizado (PHONE_HASH_SECRET), nunca o número. Sem FK (permanente).
model TrialClaim {
  phoneHash String   @id @map("phone_hash") @db.VarChar(64)
  userId    String?  @map("user_id") @db.Uuid
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  @@map("trial_claims")
}

/// atendimento do suporte; no máximo UM não resolvido por pessoa (índice único parcial support_threads_one_open_uq)
model SupportThread {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  /// 'open' (esperando a equipe) | 'pending' (esperando a pessoa) | 'resolved'
  status          String           @default("open") @db.VarChar(10)
  assignedTo      String?          @map("assigned_to") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastMessageAt   DateTime         @default(now()) @map("last_message_at") @db.Timestamptz(6)
  userUnread      Int              @default(0) @map("user_unread")
  staffUnread     Int              @default(0) @map("staff_unread")
  firstResponseAt DateTime?        @map("first_response_at") @db.Timestamptz(6)
  rating          Int?             @db.SmallInt
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  /// aberto pelo botão de emergência: topo da fila enquanto não resolvido (índice parcial support_threads_urgent_idx)
  urgent          Boolean          @default(false)
  /// quando virou urgente (CHECK support_threads_urgent_chk: urgent exige urgent_at)
  urgentAt        DateTime?        @map("urgent_at") @db.Timestamptz(6)
  messages        SupportMessage[]

  @@index([status, lastMessageAt(sort: Desc)], map: "support_threads_queue_idx")
  @@index([userId, createdAt(sort: Desc)], map: "support_threads_user_idx")
  @@map("support_threads")
}

model SupportMessage {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId  String        @map("thread_id") @db.Uuid
  senderId  String?       @map("sender_id") @db.Uuid
  /// 'user' | 'staff' | 'system'
  author    String        @db.VarChar(8)
  body      String
  /// nota interna: só a equipe vê
  internal  Boolean       @default(false)
  clientId  String?       @map("client_id") @db.VarChar(64)
  createdAt DateTime      @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId], map: "support_messages_sender_client_uq")
  @@index([threadId, createdAt], map: "support_messages_thread_idx")
  @@map("support_messages")
}

// ---------- leva 04/10/2026 (migration 20261004000000_discovery_safety_metrics) ----------
// FKs (users ON DELETE CASCADE / SET NULL) só na migration: sem relação aqui, o modelo User não muda.

/// "Passar" salvo: quem user_id passou some do DECK dele por DISCOVERY_PASS_DAYS (padrão 30); o mapa continua mostrando.
/// Passar de novo renova createdAt; a limpeza apaga o que venceu. CHECK passes_not_self_chk (user_id <> target_id).
model Pass {
